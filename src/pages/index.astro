---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ad from '../components/Ad.astro';
import { SITE_NAME, SITE_DESC, KIND_LABEL } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id)).slice(0, 40);
const fmt = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' });
---
<Base>
  <h1 class="page-title">{SITE_NAME} · 오늘의 이슈</h1>
  <p class="meta" style="margin-bottom:16px">{SITE_DESC}</p>
  {posts.length === 0 && <p>아직 발행된 글이 없습니다.</p>}
  {posts.map((p, i) => (
    <>
      <a class="card" href={`${base}/posts/${p.id}/`}>
        <span class="tag">{p.data.category}</span><span class="tag kind">{KIND_LABEL[p.data.kind]}</span><span class="meta">{fmt(p.data.date)}</span>
        <h2>{p.data.title}</h2>
        <p>{p.data.description}</p>
      </a>
      {(i + 1) % 6 === 0 && <div class="in-article-ad"><Ad /></div>}
    </>
  ))}
</Base>
