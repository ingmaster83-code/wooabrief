---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' });
---
<Base>
  {posts.length === 0 && <p>아직 발행된 글이 없습니다.</p>}
  {posts.map((p) => (
    <a class="card" href={`${base}/posts/${p.id}/`}>
      <span class="tag">{p.data.category}</span><span class="meta">{fmt(p.data.date)}</span>
      <h2>{p.data.title}</h2>
      <p>{p.data.description}</p>
    </a>
  ))}
</Base>
