---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Ad from '../../components/Ad.astro';
import { DISCLAIMER, SITE_NAME, KIND_LABEL, OFFICIAL_LINKS } from '../../config';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' });
const iso = post.data.date.toISOString();

// 같은 분야 + 태그가 겹치는 글을 연관 글로 (뉴스 ↔ 용어 해설이 서로 이어짐)
const tagSet = new Set(post.data.tags.map((t) => t.replace(/\s+/g, '')));
const related = all
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .map((p) => ({ p, score: p.data.tags.filter((t) => tagSet.has(t.replace(/\s+/g, ''))).length + (p.data.kind !== post.data.kind ? 0.5 : 0) }))
  .filter((x) => x.score >= 1)
  .sort((a, b) => b.score - a.score || b.p.data.date.valueOf() - a.p.data.date.valueOf())
  .slice(0, 5)
  .map((x) => x.p);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: iso,
  dateModified: iso,
  keywords: post.data.tags.join(', '),
  author: { '@type': 'Organization', name: SITE_NAME },
  publisher: { '@type': 'Organization', name: SITE_NAME },
};
---
<Base title={post.data.title} description={post.data.description} type="article">
  <nav class="breadcrumb">
    <a href={`${base}/`}>홈</a> › <a href={`${base}/category/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a>
  </nav>
  <article class="post">
    <span class="tag">{post.data.category}</span><span class="tag kind">{KIND_LABEL[post.data.kind]}</span><span class="meta">{fmt(post.data.date)}</span>
    <h1>{post.data.title}</h1>
    <Content />
    <div class="in-article-ad"><Ad /></div>

    {related.length > 0 && (
      <section class="related">
        <strong>함께 보면 좋은 글</strong>
        <ul>
          {related.map((r) => (
            <li><a href={`${base}/posts/${r.id}/`}>{r.data.title}</a> <span class="meta">· {KIND_LABEL[r.data.kind]}</span></li>
          ))}
        </ul>
      </section>
    )}

    {post.data.tags.length > 0 && (
      <p class="tags">{post.data.tags.map((t) => <span class="chip">#{t}</span>)}</p>
    )}

    {post.data.sources.length > 0 && (
      <section class="sources">
        <strong>참고한 보도</strong>
        <ul>
          {post.data.sources.map((s) => (
            <li><a href={s.link} rel="nofollow noopener" target="_blank">{s.title}</a> <span class="meta">({s.publisher})</span></li>
          ))}
        </ul>
      </section>
    )}

    <section class="sources">
      <strong>공식 확인처</strong>
      <p>{OFFICIAL_LINKS[post.data.category].map((o, i) => <>{i > 0 && ' · '}<a href={o.url} rel="noopener" target="_blank">{o.name}</a></>)}</p>
    </section>

    <p class="notice">{DISCLAIMER}</p>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Base>
