---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../config';

export function getStaticPaths() {
  return CATEGORIES.map((cat) => ({ params: { cat } }));
}
const { cat } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('posts'))
  .filter((p) => p.data.category === cat)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' });
---
<Base title={cat} description={`${cat} 분야 오늘의 이슈 정리`}>
  <h1>{cat}</h1>
  {posts.length === 0 && <p>아직 발행된 글이 없습니다.</p>}
  {posts.map((p) => (
    <a class="card" href={`${base}/posts/${p.id}/`}>
      <span class="meta">{fmt(p.data.date)}</span>
      <h2>{p.data.title}</h2>
      <p>{p.data.description}</p>
    </a>
  ))}
</Base>
