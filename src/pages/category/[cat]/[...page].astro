---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import Pagination from '../../../components/Pagination.astro';
import TopicChips from '../../../components/TopicChips.astro';
import { getSortedPosts, PAGE_SIZE, SUBS, type Category } from '../../../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
  const all = await getSortedPosts();
  return (Object.keys(SUBS) as Category[]).flatMap((cat) => {
    const posts = all.filter((p) => p.data.category === cat);
    return paginate(posts, { params: { cat }, pageSize: PAGE_SIZE, props: { cat, posts } });
  });
}) satisfies GetStaticPaths;

const { page, cat, posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/category/${encodeURIComponent(cat)}/`;
const suffix = page.currentPage > 1 ? ` ${page.currentPage}페이지` : '';
---
<Base title={`${cat} 이슈·가이드${suffix}`} description={`${cat} 분야의 오늘 이슈와 용어·제도 해설을 모았습니다.`}>
  <nav class="breadcrumb"><a href={`${base}/`}>홈</a> › <span>{cat}</span></nav>
  <h1 class="page-title">{cat}</h1>
  <TopicChips posts={posts} category={cat} />
  <p class="meta list-count">{cat} 글 {page.total}편 · {page.currentPage}/{page.lastPage} 페이지</p>
  <PostList posts={page.data} />
  <Pagination page={page} root={root} />
</Base>
