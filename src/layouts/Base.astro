---
import { SITE_NAME, SITE_ICON, SITE_TITLE, SITE_DESC, CATEGORIES, SISTER_SITES, ADSENSE_CLIENT, GA_ID } from '../config';
import Ad from '../components/Ad.astro';
interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  sidebar?: boolean;   // 오른쪽 스티키 사이드바 광고 (본문 전체를 감쌈)
  topAd?: boolean;     // 헤더 아래 배너 광고
}
const { title, description = SITE_DESC, type = 'website', sidebar = true, topAd = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary" />
    <meta name="naver-site-verification" content="c3a13e8deccec541095f556a76bbfef25b98569e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>${SITE_ICON}</text></svg>`} />

    <!-- Google Analytics -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',GA_ID);</script>
    <!-- AdSense -->
    <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href={`${base}/`} class="site-logo"><span class="logo-icon">{SITE_ICON}</span><span class="logo-text">{SITE_NAME}</span></a>
        <nav class="header-nav">
          {CATEGORIES.map((c) => <a href={`${base}/category/${encodeURIComponent(c)}/`}>{c}</a>)}
          <a href={`${base}/guide/`}>용어·제도 해설</a>
          <a href={`${base}/issues/`}>이슈 분석</a>
          <a href="https://wooahouse.com" rel="noopener">WooaHouse →</a>
        </nav>
      </div>
    </header>

    <script is:inline src={`${base}/js/wooa-sites-bar.js`}></script>
    <script is:inline src={`${base}/js/ad-dev-placeholder.js`}></script>

    {topAd && <div class="top-ad-bar"><Ad /></div>}

    <main class="site-main">
      {sidebar ? (
        <div class="page-with-sidebar">
          <div class="content-col"><slot /></div>
          <aside class="tool-sidebar"></aside>
        </div>
      ) : (
        <div class="content-col solo"><slot /></div>
      )}
    </main>
    <script is:inline src={`${base}/js/wooa-sidebar.js`}></script>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-disclaimer">
          본 사이트의 글은 공개된 언론 보도를 바탕으로 정리한 정보 제공용 콘텐츠이며, 투자·가입·계약을 권유하지 않습니다.<br />
          정확한 내용은 반드시 원문 기사와 공식 기관의 안내를 확인하세요.
        </p>
        <p class="footer-links">
          <a href="https://wooahouse.com" rel="noopener">WooaHouse</a>
          {SISTER_SITES.map((s) => <> · <a href={s.url} rel="noopener">{s.name}</a></>)}
        </p>
        <p class="footer-links">
          <a href={`${base}/about/`}>서비스 소개</a> · <a href={`${base}/privacy/`}>개인정보처리방침</a>
        </p>
        <p class="copyright">&copy; {new Date().getFullYear()} {SITE_NAME} · WooaHouse. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --primary: #1E40AF; --primary-dark: #172554; --primary-light: #DBEAFE;
    --accent: #F59E0B; --text: #1F2937; --text-muted: #6B7280; --border: #E5E7EB;
    --bg: #F9FAFB; --white: #fff; --radius: 10px; --shadow: 0 2px 8px rgba(0,0,0,.08);
  }
  body { font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, 'Malgun Gothic', sans-serif; color: var(--text); background: var(--bg); font-size: 16px; line-height: 1.7; }
  a { color: var(--primary); text-decoration: none; }
  a:hover { text-decoration: underline; }

  /* 헤더 */
  .site-header { background: var(--white); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
  .header-inner { max-width: 1100px; margin: 0 auto; padding: 0 20px; display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .site-logo { display: flex; align-items: center; gap: 8px; font-size: 1.2rem; font-weight: 700; color: var(--text); text-decoration: none; }
  .logo-icon { font-size: 1.4rem; }
  .header-nav { display: flex; gap: 20px; }
  .header-nav a { color: var(--text-muted); font-size: .9rem; font-weight: 500; text-decoration: none; transition: color .2s; }
  .header-nav a:hover { color: var(--primary); }

  /* 패밀리 사이트 바 (wooa-sites-bar.js 가 주입) */
  .our-sites-bar { background: #111827; border-top: 1px solid rgba(255,255,255,.08); border-bottom: 1px solid rgba(255,255,255,.08); }
  .our-sites-inner { max-width: 1160px; margin: 0 auto; padding: 7px 20px 9px; display: flex; flex-direction: column; gap: 5px; }
  .our-sites-label { color: rgba(255,255,255,.6); font-size: .88rem; font-weight: 600; letter-spacing: .3px; white-space: nowrap; text-align: center; width: 100%; }
  .our-sites-links { display: flex; gap: 3px; flex-wrap: wrap; }
  .our-sites-links a { color: rgba(255,255,255,.75); text-decoration: none; font-size: .78rem; font-weight: 500; padding: 4px 10px; border-radius: 20px; white-space: nowrap; transition: background .15s, color .15s; }
  .our-sites-links a:hover { background: rgba(255,255,255,.12); color: #fff; text-decoration: none; }
  .our-sites-links a.active { background: rgba(255,255,255,.18); color: #fff; }

  /* 광고 / 레이아웃 */
  .top-ad-bar { max-width: 900px; margin: 0 auto; padding: 8px 20px; text-align: center; }
  .ad-slot { min-height: 50px; }
  .site-main { min-height: calc(100vh - 120px); padding-top: 24px; }
  .page-with-sidebar { max-width: 1160px; margin: 0 auto; padding: 0 20px; display: grid; grid-template-columns: 1fr 300px; gap: 24px; align-items: start; }
  .content-col { min-width: 0; }
  .content-col.solo { max-width: 800px; margin: 0 auto; padding: 0 20px; }
  .tool-sidebar { position: sticky; top: 76px; }
  .ad-card { background: #fff; border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,.08); border: 1.5px dashed #e5e7eb; padding: 14px; display: flex; flex-direction: column; align-items: center; min-height: 280px; margin-bottom: 16px; }
  @media (max-width: 1024px) { .page-with-sidebar { grid-template-columns: 1fr; } .tool-sidebar { display: none; } }

  /* 푸터 */
  .site-footer { background: #111827; color: #9CA3AF; padding: 32px 20px; text-align: center; font-size: .85rem; line-height: 1.8; margin-top: 60px; }
  .footer-links { margin: 8px 0; }
  .footer-links a { color: #9CA3AF; }
  .footer-links a:hover { color: #93C5FD; }
  .footer-disclaimer { font-size: .78rem; color: #6B7280; margin: 8px 0; }
  .copyright { color: #6B7280; margin-top: 8px; }

  /* 카드·글 */
  .page-title { font-size: 1.5rem; font-weight: 800; margin-bottom: 16px; }
  .card { display: block; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 18px; margin-bottom: 12px; color: inherit; text-decoration: none; }
  .card:hover { box-shadow: var(--shadow); text-decoration: none; border-color: var(--primary); }
  .card h2 { margin: 6px 0 6px; font-size: 1.1rem; line-height: 1.45; color: var(--text); }
  .card p { color: var(--text-muted); font-size: .92rem; }
  .meta { color: var(--text-muted); font-size: .82rem; }
  .tag { display: inline-block; font-size: .75rem; padding: 2px 10px; border-radius: 99px; background: var(--primary-light); color: var(--primary-dark); margin-right: 8px; font-weight: 600; }
  .breadcrumb { font-size: .83rem; color: var(--text-muted); margin-bottom: 12px; display: flex; gap: 6px; flex-wrap: wrap; }
  article.post { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px 22px; }
  article.post h1 { font-size: 1.6rem; line-height: 1.4; margin: 10px 0 18px; font-weight: 800; }
  article.post h2 { font-size: 1.2rem; margin: 2rem 0 .6rem; padding-left: 10px; border-left: 4px solid var(--primary); }
  article.post h3 { font-size: 1.05rem; margin: 1.4rem 0 .4rem; }
  article.post p { margin-bottom: 1rem; }
  article.post ul, article.post ol { padding-left: 20px; margin-bottom: 1rem; }
  article.post a { text-decoration: underline; text-underline-offset: 2px; }
  article.post table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: .92rem; }
  article.post th, article.post td { border: 1px solid var(--border); padding: 8px 10px; text-align: left; vertical-align: top; }
  article.post th { background: var(--bg); }
  .tag.kind { background: #FEF3C7; color: #92400E; }
  .tag.sub { background: #E0E7FF; color: #3730A3; }
  .list-count { margin: 14px 0 12px; }
  .chips-wrap { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 14px; display: grid; gap: 8px; }
  .chips-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .chips-cat { font-size: .82rem; font-weight: 700; color: var(--text); background: var(--bg); border: 1px solid var(--border); padding: 3px 12px; border-radius: 99px; text-decoration: none; margin-right: 4px; }
  .chips-cat.on { background: var(--primary); border-color: var(--primary); color: #fff; }
  .chip-link { font-size: .82rem; color: var(--text-muted); border: 1px solid var(--border); padding: 3px 10px; border-radius: 99px; text-decoration: none; background: var(--white); }
  .chip-link em { font-style: normal; font-size: .72rem; color: #9CA3AF; margin-left: 5px; }
  .chip-link:hover { border-color: var(--primary); color: var(--primary); text-decoration: none; }
  .chip-link.on { background: var(--primary-light); border-color: var(--primary); color: var(--primary-dark); font-weight: 600; }
  .pager { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: 28px 0 8px; }
  .pager a, .pager span { min-width: 36px; padding: 6px 12px; text-align: center; border: 1px solid var(--border); border-radius: 8px; background: var(--white); font-size: .9rem; color: var(--text); text-decoration: none; }
  .pager a:hover { border-color: var(--primary); color: var(--primary); text-decoration: none; }
  .pager .cur { background: var(--primary); border-color: var(--primary); color: #fff; font-weight: 700; }
  .pager .off { color: #CBD5E1; background: var(--bg); }
  .pager .gap { border: none; background: none; min-width: 0; padding: 6px 2px; color: var(--text-muted); }
  @media (max-width: 640px) { .header-inner { height: auto; min-height: 56px; flex-wrap: wrap; padding-top: 6px; padding-bottom: 6px; } .header-nav { gap: 12px; flex-wrap: wrap; } }
  .related { margin-top: 1.8rem; padding: 14px 16px; background: var(--bg); border-radius: var(--radius); font-size: .92rem; }
  .related ul { padding-left: 18px; margin-top: 6px; }
  .tags { margin-top: 1.2rem; }
  .chip { display: inline-block; font-size: .78rem; color: var(--text-muted); background: var(--bg); border: 1px solid var(--border); padding: 1px 9px; border-radius: 99px; margin: 0 6px 6px 0; }
  .in-article-ad { margin: 1.6rem 0; }
  .sources, .notice { font-size: .86rem; color: var(--text-muted); border-top: 1px solid var(--border); margin-top: 1.8rem; padding-top: 1rem; }
  .sources ul { padding-left: 18px; }
  .legal { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px 22px; }
  .legal h1 { font-size: 1.5rem; margin-bottom: 18px; }
  .legal h2 { font-size: 1.1rem; margin: 24px 0 8px; }
  .legal ul { padding-left: 20px; }
  .ad-placeholder { background: #F1F5F9; border: 1px dashed #CBD5E1; border-radius: 6px; color: #94A3B8; font-size: .82rem; padding: 14px; text-align: center; }
</style>
